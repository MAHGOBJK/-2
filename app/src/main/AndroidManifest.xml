<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    package="com.muhgoub.panel">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_shield"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Panel">

        <!-- 🟢 تصحيح السطر وإضافة المعرّف القياسي بالملي لشاشة الاسبلاش -->
        <activity
            android:name="com.muhgoub.panel.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🟢 تصحيح السطر وإضافة المعرّف القياسي للشاشة الرئيسية -->
        <activity
            android:name="com.muhgoub.panel.MainActivity"
            android:exported="false" />

        <!-- 🟢 تصحيح السطر وإضافة المعرّف القياسي للخدمة الخلفية العائمة للوحة التحكم -->
        <service
            android:name="com.muhgoub.panel.OverlayService"
            android:exported="false" />

    </application>
</manifest>
